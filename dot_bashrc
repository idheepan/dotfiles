#
# ~/.bashrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

alias ls='ls --color=auto'
alias grep='rg --color=auto'
alias v='nvim'
alias gg='lazygit'
alias cd='z'
# PS1='[\u@\h \W]\$ '

# Change this if we move to different terminal 
# emulator
export TERM=xterm-256color
export COLORTERM=truecolor
export EDITOR=nvim
export VISUAL=nvim
export PATH="$HOME/.cargo/bin:$HOME/.bun/bin:$HOME/bin:$HOME/.local/bin/:/opt/cuda/bin/:$PATH"

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# For android studio and tauri
if [ -d "/opt/android-studio" ] && [ -d "$HOME/Android/Sdk" ]; then
    export JAVA_HOME=/opt/android-studio/jbr
    export ANDROID_HOME="$HOME/Android/Sdk"
    # Safely check for the NDK directory to avoid 'ls' errors on startup
    if [ -d "$ANDROID_HOME/ndk" ]; then
        # Use head -n 1 in case multiple NDK versions are installed
        export NDK_HOME="$ANDROID_HOME/ndk/$(ls -1 "$ANDROID_HOME/ndk" | head -n 1)"
    fi
fi


eval "$(fzf --bash)"
eval "$(starship init bash)"
# Keep this at the end of .bashrc
eval "$(zoxide init bash)"
