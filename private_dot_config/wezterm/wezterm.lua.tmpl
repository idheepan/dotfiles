local wezterm = require("wezterm")
local config = wezterm.config_builder()

-- nil when loaded by wezterm-mux-server.
local is_headless = {{.wezterm.headless}}

if  not is_headless then
  config.ssh_domains = require("ssh_domains")
  config.unix_domains = require("unix_domains")
  config.window_close_confirmation = "NeverPrompt"
	config.initial_cols = 150
	config.initial_rows = 70

	config.font = wezterm.font_with_fallback({
		"IosevkaTerm Nerd Font",
		"Noto Color Emoji",
	})

	{{ if eq .chezmoi.os "darwin" -}}
	config.font_size = 15.0
	config.window_frame = { font_size = 13.0 }
	config.native_macos_fullscreen_mode = true
	{{ else -}}
	config.window_decorations = "NONE"
	config.font_size = 10.0
	config.window_frame = { font_size = 9.0 }
	{{ end -}}

	config.color_scheme = "Catppuccin Mocha"
	config.hide_tab_bar_if_only_one_tab = true
	config.adjust_window_size_when_changing_font_size = false

	config.keys = require("keys")

	-- Avoid loading/cloning the plugin in the mux-server process.
	local smart_splits =
		wezterm.plugin.require("https://github.com/mrjones2014/smart-splits.nvim")

	smart_splits.apply_to_config(config, {
		direction_keys = { "h", "j", "k", "l" },
		modifiers = {
			move = "CTRL",
			resize = "META",
		},
	})

	local catppuccin_mocha = {
		base = "#1e1e2e",
		surface1 = "#45475a",
		sky = "#89dceb",
	}

	local function tab_title(tab_info)
		if tab_info.tab_title and #tab_info.tab_title > 0 then
			return tab_info.tab_title
		end

		return tab_info.active_pane.title or ""
	end

	wezterm.on("format-tab-title", function(tab, _, _, _, _, max_width)
		local background = catppuccin_mocha.base
		local foreground = tab.is_active
				and catppuccin_mocha.sky
			or catppuccin_mocha.surface1

		local title = tab_title(tab)

		-- Be defensive if a version/context doesn't supply max_width.
		if max_width and max_width > 2 then
			title = wezterm.truncate_right(title, max_width - 2)
		end

		return {
			{ Background = { Color = background } },
			{ Foreground = { Color = foreground } },
			{
				Text = string.format(
					"  %d    %s  ",
					tab.tab_index + 1,
					title
				),
			},
		}
	end)
end

return config
