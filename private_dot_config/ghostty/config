theme  = catppuccin-mocha.conf

# Send Alt/Meta escapes for Option key presses (macOS only; ignored elsewhere)
# so tmux's `M-h/j/k/l` pane-navigation bindings work.
macos-option-as-alt = left

# Nerd Font Mono (>= 3.5) so newer glyphs like the Claude logo used in the
# tmux status bar render; Ghostty's built-in default font lacks them.
font-family = "IosevkaTerm Nerd Font Mono"
